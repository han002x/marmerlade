flowchart TD
  reviewer@{ icon: "lucide:user", form: "rounded", label: "Xray reviewer" }
  subgraph setup ["Freeze study"]
    sources@{ icon: "lucide:layers", form: "rounded", label: "Final + original" }
    area@{ img: "data:image/svg+xml;base64,", label: "Working area", w: 128, h: 128 }
    provenance{"Original?"}
  end
  authoring@{ icon: "logos:kiro", form: "rounded", label: "Kiro · authoring tool" }
  subgraph review ["Review stages"]
    s1("1 · Grade review")
    s3("3 · EML / MCGPR")
    s4("4 · Trial trench")
    s5("5 · Grade audit")
    skip("Skip 1–5 + reason")
    subgraph geometry ["2 · Geometry review"]
      anchor("Final GeoCUP anchor")
      match{"Paired?"}
      tolerance("Within tolerance")
      deviation("Deviation + correction")
      unmatched("No baseline match")
    end
  end
  subgraph compile ["6 · Compile DIR"]
    ready{"Ready?"}
    copy("Copy original as E")
    blocked@{ icon: "lucide:lock", form: "rounded", label: "Resolve block" }
  end
  subgraph outputs ["Report + GIS"]
    xlsx@{ icon: "lucide:file", form: "rounded", label: "Excel workbook" }
    gis@{ icon: "lucide:layers", form: "rounded", label: "GDB with layer IDs" }
    empty("Empty ≠ accurate")
  end
  reviewer -->|start| setup
  setup -->|frozen sources| review
  review -->|complete / skip| compile
  compile -->|generated| outputs
  sources --> area
  area --> provenance
  s1 --> geometry
  geometry --> s3
  s3 --> s4
  s4 --> s5
  anchor --> match
  match -->|paired < rule| tolerance
  match -->|paired ≥ rule| deviation
  match -->|reject / unmatched| unmatched
  ready -->|yes| copy
  ready -->|no / invalid| blocked
  xlsx -->|if layers| gis
  xlsx -->|all skipped| empty
